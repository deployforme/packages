{
  "name": "@hivelet/hivelet",
  "version": "1.0.1",
  "description": "Safe runtime module management for modern Node.js applications",
  "keywords": [
    "hivelet",
    "hot-reload",
    "module-loading",
    "runtime",
    "zero-downtime"
  ],
  "author": "Hacı Mert Gökhan <hacimertgokhan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hivelet/packages.git"
  },
  "bugs": {
    "url": "https://github.com/hivelet/packages/issues"
  },
  "homepage": "https://github.com/hivelet/packages#readme",
  "private": false,
  "packageManager": "pnpm@10.26.0",
  "workspaces": [
    "packages/*",
    "examples/*",
    "benchmarks"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "docs:serve": "node scripts/serve-docs.cjs serve",
    "docs:build": "node scripts/build-docs.cjs",
    "publish:core": "pnpm --dir packages/core publish --access public",
    "publish:adapter-express": "pnpm --dir packages/adapter-express publish --access public",
    "publish:adapter-hono": "pnpm --dir packages/adapter-hono publish --access public",
    "publish:adapter-nest": "pnpm --dir packages/adapter-nest publish --access public",
    "publish:all": "pnpm build && pnpm publish:core && pnpm publish:adapter-express && pnpm publish:adapter-hono && pnpm publish:adapter-nest"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
