{
  "name": "@hivelet/nest-example",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "ts-node src/main.ts",
    "dev:monitoring": "ts-node src/main-monitoring.ts",
    "dev:di": "ts-node src/main-with-di.ts",
    "dev:graceful": "ts-node src/main-graceful.ts",
    "build": "tsc && node scripts/copy-modules.cjs",
    "typecheck": "tsc --noEmit --pretty false",
    "start": "node dist/main.js",
    "start:monitoring": "node dist/main-monitoring.js",
    "start:di": "node dist/main-with-di.js",
    "start:graceful": "node dist/main-graceful.js"
  },
  "dependencies": {
    "@hivelet/core": "workspace:*",
    "@hivelet/adapter-nest": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
