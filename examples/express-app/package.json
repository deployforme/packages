{
  "name": "@hivelet/express-example",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dev:monitoring": "ts-node src/index-monitoring.ts",
    "dev:di": "ts-node src/index-with-di.ts",
    "dev:graceful": "ts-node src/index-graceful.ts",
    "demo": "ts-node src/demo-zero-downtime.ts",
    "build": "tsc && node scripts/copy-modules.cjs",
    "typecheck": "tsc --noEmit --pretty false",
    "start": "node dist/index.js",
    "start:prod": "node dist/index-prod.js",
    "start:monitoring": "node dist/index-monitoring.js",
    "start:di": "node dist/index-with-di.js",
    "start:graceful": "node dist/index-graceful.js"
  },
  "dependencies": {
    "@hivelet/core": "workspace:*",
    "@hivelet/adapter-express": "workspace:*",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
