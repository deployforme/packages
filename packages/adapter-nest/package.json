{
  "name": "@hivelet/adapter-nest",
  "version": "1.0.5",
  "description": "NestJS Express platform adapter for Hivelet runtime modules",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "hivelet",
    "nestjs",
    "express",
    "adapter"
  ],
  "author": "Hacı Mert Gökhan <hacimertgokhan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hivelet/packages.git",
    "directory": "packages/adapter-nest"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hivelet/adapter-express": "workspace:^",
    "@hivelet/core": "workspace:^"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/platform-express": "^10.0.0 || ^11.0.0",
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "express": "^4.21.2",
    "typescript": "^5.3.0"
  }
}
